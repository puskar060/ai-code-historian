import React, { useState, useEffect, useRef } from 'react';
import axios from 'axios';
import { Canvas, useFrame } from '@react-three/fiber';
import { OrbitControls, Text } from '@react-three/drei';
import * as THREE from 'three';
import { Play, Pause, GitCommit, Cpu, Sparkles } from 'lucide-react';

// 3D File Node Component
function FileNode({ node, onClick, isSelected }) {
  const meshRef = useRef();

  useFrame((state) => {
    if (isSelected) {
      meshRef.current.rotation.y += 0.02;
    }
  });

  return (
    <group position={[node.x, node.y, node.z]}>
      <mesh
        ref={meshRef}
        onClick={() => onClick(node)}
        scale={isSelected ? 1.5 : 1}
      >
        <sphereGeometry args={[node.val * 0.2, 32, 32]} />
        <meshStandardMaterial 
          color={node.churn > 5 ? "#ef4444" : "#3b82f6"} 
          emissive={isSelected ? "#ffffff" : "#000000"}
        />
      </mesh>
      <Text
        position={[0, node.val * 0.2 + 0.5, 0]}
        fontSize={0.4}
        color="white"
        anchorX="center"
        anchorY="middle"
      >
        {node.id.split('/').pop()}
      </Text>
    </group>
  );
}

export default function App() {
  const [repoPath, setRepoPath] = useState('');
  const [graphData, setGraphData] = useState({ nodes: [], links: [], timeline: [] });
  const [selectedNode, setSelectedNode] = useState(null);
  const [currentCommitIndex, setCurrentCommitIndex] = useState(0);
  const [aiNarrative, setAiNarrative] = useState('');
  const [loading, setLoading] = useState(false);

  const handleParseRepo = async (e) => {
    e.preventDefault();
    setLoading(true);
    try {
      const res = await axios.post('http://localhost:8000/api/parse-repo', { repo_path: repoPath });
      setGraphData(res.data);
    } catch (err) {
      alert("Error parsing repo. Check path!");
    }
    setLoading(false);
  };

  const fetchAiNarrative = async (commit) => {
    if (!commit) return;
    try {
      const res = await axios.post('http://localhost:8000/api/ai-narrative', { commit_data: commit });
      setAiNarrative(res.data.narrative);
    } catch (err) {
      setAiNarrative("Could not fetch AI insight.");
    }
  };

  useEffect(() => {
    if (graphData.timeline && graphData.timeline.length > 0) {
      fetchAiNarrative(graphData.timeline[currentCommitIndex]);
    }
  }, [currentCommitIndex, graphData]);

  return (
    <div className="flex h-screen bg-slate-950 text-white font-sans">
      {/* Sidebar - Controls & AI Insights */}
      <div className="w-1/3 p-6 border-r border-slate-800 flex flex-col justify-between overflow-y-auto">
        <div>
          <div className="flex items-center gap-2 mb-6">
            <Cpu className="w-8 h-8 text-blue-500" />
            <h1 className="text-xl font-bold bg-gradient-to-r from-blue-400 to-indigo-500 bg-clip-text text-transparent">
              AI Code Historian
            </h1>
          </div>

          <form onSubmit={handleParseRepo} className="mb-6">
            <label className="text-sm text-slate-400 mb-2 block">Local Git Repository Path:</label>
            <input 
              type="text" 
              value={repoPath} 
              onChange={(e) => setRepoPath(e.target.value)}
              placeholder="/Users/username/project" 
              className="w-full p-3 bg-slate-900 border border-slate-700 rounded-lg text-sm mb-3 focus:outline-none focus:border-blue-500"
            />
            <button 
              type="submit" 
              className="w-full py-3 bg-blue-600 hover:bg-blue-500 rounded-lg font-medium text-sm transition"
            >
              {loading ? "Analyzing AST & Git..." : "Visualize Repository"}
            </button>
          </form>

          {/* Timeline Controller */}
          {graphData.timeline.length > 0 && (
            <div className="bg-slate-900 p-4 rounded-xl border border-slate-800 mb-6">
              <div className="flex justify-between items-center mb-2">
                <span className="text-xs text-slate-400 flex items-center gap-1">
                  <GitCommit className="w-4 h-4 text-blue-400" /> 
                  Commit {currentCommitIndex + 1} of {graphData.timeline.length}
                </span>
                <span className="text-xs font-mono bg-blue-950 text-blue-300 px-2 py-0.5 rounded">
                  {graphData.timeline[currentCommitIndex]?.hash}
                </span>
              </div>
              <p className="text-sm font-medium mb-3">{graphData.timeline[currentCommitIndex]?.message}</p>
              <input 
                type="range" 
                min="0" 
                max={graphData.timeline.length - 1} 
                value={currentCommitIndex}
                onChange={(e) => setCurrentCommitIndex(parseInt(e.target.value))}
                className="w-full accent-blue-500 cursor-pointer"
              />
            </div>
          )}

          {/* AI Historian Narrative */}
          <div className="bg-gradient-to-br from-slate-900 to-blue-950/40 p-4 rounded-xl border border-blue-900/40">
            <div className="flex items-center gap-2 mb-2 text-blue-400">
              <Sparkles className="w-5 h-5" />
              <h3 className="font-semibold text-sm">AI Architect Insight</h3>
            </div>
            <div className="text-xs text-slate-300 whitespace-pre-line leading-relaxed">
              {aiNarrative || "Load a repository and scrub the timeline to view architectural evolution insights."}
            </div>
          </div>
        </div>

        <div className="text-xs text-slate-500 text-center pt-4">
          Spatial-Temporal AI Code Historian &bull; Built with FastAPI & Three.js
        </div>
      </div>

      {/* 3D Viewport */}
      <div className="w-2/3 relative">
        <Canvas camera={{ position: [0, 0, 20], fov: 60 }}>
          <color attach="background" args={['#020617']} />
          <ambientLight intensity={1} />
          <pointLight position={[10, 10, 10]} intensity={1.5} />
          <OrbitControls enablePan={true} enableZoom={true} enableRotate={true} />

          {/* Render File Nodes */}
          {graphData.nodes.map((node) => (
            <FileNode 
              key={node.id} 
              node={node} 
              onClick={(n) => setSelectedNode(n)} 
              isSelected={selectedNode?.id === node.id}
            />
          ))}
        </Canvas>

        {selectedNode && (
          <div className="absolute top-6 right-6 bg-slate-900/90 backdrop-blur p-4 rounded-xl border border-slate-700 w-72 shadow-2xl">
            <h4 className="font-semibold text-sm text-blue-400 mb-1">{selectedNode.id}</h4>
            <p className="text-xs text-slate-300">Code Churn Count: <span className="font-bold text-white">{selectedNode.churn}</span></p>
            <button 
              onClick={() => setSelectedNode(null)} 
              className="mt-3 text-xs bg-slate-800 hover:bg-slate-700 px-3 py-1 rounded"
            >
              Close
            </button>
          </div>
        )}
      </div>
    </div>
  );
}